# ── GadgetHub Backend Environment ─────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env

PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/gadgethub

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# Client URL (CORS + email links)
FRONTEND_URL=http://localhost:3000

# Google OAuth (server-side token verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (Gmail app password / Mailtrap / SendGrid SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Gadget Hub <no-reply@gadgethub.io>"

# Seed admin (used by npm run seed)
SEED_ADMIN_EMAIL=admin@gadgethub.io
SEED_ADMIN_PASSWORD=Admin@1234
